    "paths": {
        "/nc/com/financialblocks/orders": {
            "post": {
                "summary": "(action = SUSPEND / RESUME): Solicitar bloqueio/desbloqueio financeiro de conta. Backend: Sistema COM (Customer Order Management) da Netcracker",
                "operationId": "sendBillingAction",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/FinancialBlocksRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "$ref": "#/components/responses/SucessResponse"
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "405": {
                        "$ref": "#/components/responses/MethodNotAllowed"
                    },
                    "406": {
                        "$ref": "#/components/responses/NotAcceptable"
                    },
                    "415": {
                        "$ref": "#/components/responses/UnsupportedMediaType"
                    },
                    "422": {
                        "$ref": "#/components/responses/UnprocessableEntity"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    },
                    "503": {
                        "$ref": "#/components/responses/ServiceUnavailable"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "BasicAuth": {
                "type": "http",
                "scheme": "basic"
            },
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer"
            },
            "ApiKeyAuth": {
                "type": "apiKey",
                "in": "header",
                "name": "X-Client-Key"
            },
            "OAuth2": {
                "type": "oauth2",
                "flows": {
                    "clientCredentials": {
                        "tokenUrl": "/oauth2/v1/token",
                        "scopes": {}
                    }
                }
            }
        },
        "schemas": {
            "FinancialBlocksRequest": {
                "type": "object",
                "description": "\"Estrutura enviada pelo MS para NetCracker solicitando ação de bloqueio/desbloqueio.\"\n",
                "required": [
                    "data"
                ],
                "properties": {
                    "data": {
                        "type": "object",
                        "required": [
                            "action",
                            "correlationId",
                            "billingChargingCleAccount",
                            "serviceAcronym",
                            "customerDocumentId"
                        ],
                        "properties": {
                            "correlationId": {
                                "type": "string",
                                "description": "ID da transação (para fins de rastreamento)",
                                "example": "4c04bdc2-7130-46ed-8533-0c650b3c17a5"
                            },
                            "order": {
                                "type": "object",
                                "required": [
                                    "action",
                                    "serviceAcronym",
                                    "Matricula"
                                ],
                                "properties": {
                                    "action": {
                                        "type": "string",
                                        "enum": [
                                            "SUSPEND",
                                            "RESUME"
                                        ],
                                        "description": "Ação:\n\n    •\t\"SUSPEND\" - para bloquear o serviço em caso de inadimplência\n    •\t\"RESUME\" - para desbloquear o serviço caso as dívidas tenham sido resolvidas",
                                        "example": "SUSPEND"
                                    },
                                    "serviceAcronym": {
                                        "type": "string",
                                        "description": "Código do serviço (sigla)",
                                        "example": "INN"
                                    },
                                    "Matricula": {
                                        "type": "string",
                                        "description": "Matricula do usuario",
                                        "example": "123455"
                                    },
                                    "customer": {
                                        "required": [
                                            "billingChargingCleAccount",
                                            "customerDocumentId"
                                        ],
                                        "type": "object",
                                        "properties": {
                                            "billingChargingCleAccount": {
                                                "type": "string",
                                                "description": "Conta CLE de cobrança do cliente",
                                                "example": "92010r00901AS23DJRT_BR"
                                            },
                                            "customerDocumentId": {
                                                "type": "string",
                                                "description": "Documento do cliente (CNPJ)",
                                                "example": "44976580000122"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "FinancialBlocksResponse": {
                "type": "object",
                "description": "Registro salvo na tabela de relatório.",
                "required": [
                    "apiVersion",
                    "transactionId"
                ],
                "properties": {
                    "apiVersion": {
                        "type": "string",
                        "description": "Retorna sempre a versão major e minor da API efetivamente consumida. O formato é “versão major;versão minor”. Exemplo: “apiVersion”: “2;2026-01-07”. Quando a versão minor não é solicitada, a versão contratada pelo cliente é retornada. Quando não há restrição de contratação, retorna a última disponível.",
                        "example": "1;2026-01-07"
                    },
                    "transactionId": {
                        "type": "string",
                        "example": "b6195102-ea4f-44e8-fed5-386e4ec2a373",
                        "description": "Retorna o identificador de rastreabilidade de transação gerado pela API."
                    },
                    "data": {
                        "type": "object",
                        "required": [
                            "status"
                        ],
                        "properties": {
                            "status": {
                                "type": "string",
                                "description": "Resultado do processamento:\n\n  •\t\"OK\" - NC irá processar o bloqueio/desbloqueio\n  •\t\"ERROR\" - Ocorreu algum tipo de erro e NC não irá efetuar o bloqueio/desbloqueio",
                                "example": "OK"
                            },
                            "errorCode": {
                                "type": "string",
                                "description": "Código do erro, caso status == \"ERROR\""
                            },
                            "errorMessage": {
                                "type": "string",
                                "description": "Mensagem de erro, caso status == \"ERROR\""
                            }
                        }
                    }
                }
            },
            "errorResponse": {
                "type": "object",
                "properties": {
                    "apiVersion": {
                        "type": "string",
                        "description": "Retorna sempre a versão major e minor da API efetivamente consumida. O formato é “versão major;versão minor”. Exemplo: “apiVersion”: “1;2026-01-07”. Quando a versão minor não é solicitada, a versão contratada pelo cliente é retornada. Quando não há restrição de contratação, retorna a última disponível.",
                        "example": "1;2026-01-07"
                    },
                    "transactionId": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Retorna o identificador de rastreabilidade de transação gerado pela API.",
                        "example": "b6195102-ea4f-44e8-fed5-386e4ec2a373"
                    },
                    "error": {
                        "type": "object",
                        "description": "Detalhes do erro ocorrido.",
                        "properties": {
                            "httpCode": {
                                "type": "string",
                                "description": "Código HTTP em formato string.",
                                "example": "400"
                            },
                            "errorCode": {
                                "type": "string",
                                "description": "Código interno da API para o erro.",
                                "example": "API-NCCOMFINANCIALBLOCKSORDERS-400"
                            },
                            "message": {
                                "type": "string",
                                "description": "Mensagem resumida do erro.",
                                "example": "Bad Request."
                            },
                            "detailedMessage": {
                                "type": "string",
                                "description": "Mensagem detalhada do erro.",
                                "example": "Bad Request."
                            },
                            "link": {
                                "type": "object",
                                "description": "Link relacionado ao erro.",
                                "properties": {
                                    "rel": {
                                        "type": "string",
                                        "description": "Relação do link com o recurso.",
                                        "example": "related"
                                    },
                                    "href": {
                                        "type": "string",
                                        "format": "uri",
                                        "description": "URL para documentação ou recurso relacionado.",
                                        "example": "https://api.com.br/docs"
                                    }
                                },
                                "required": [
                                    "rel",
                                    "href"
                                ]
                            }
                        },
                        "required": [
                            "httpCode",
                            "errorCode",
                            "message"
                        ]
                    }
                },
                "required": [
                    "apiVersion",
                    "transactionId",
                    "error"
                ]
            },
            "errorResponseCOM": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "description": "Resultado do processamento",
                        "example": "ERROR"
                    },
                    "errorCode": {
                        "type": "string",
                        "description": "Código do erro, caso status == 'ERROR'",
                        "example": "ERR-001"
                    },
                    "errorMessage": {
                        "type": "string",
                        "description": "Mensagem de erro, caso status == 'ERROR'",
                        "example": "Mandatory fields missing"
                    }
                }
            }
        },
