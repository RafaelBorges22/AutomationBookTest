  "paths": {
    "/nc/com/financialblocks/orders/notifications": {
      "post": {
        "summary": "Enviar callback com o resultado do bloqueio ou desbloqueio financeiro da conta do cliente backend: MS account-cobe-financialblocksordersnotifications-v1",
        "operationId": "financialBlocksOrdersNotifications",
        "tags": [
          "Financial Blocks Orders Notifications"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinancialBlocksNotificationsRequest"
              },
                "examples": {
                    "Sucesso": {
                        "summary": "Exemplo Callback Sucesso",
                        "value": {
                            "data": {
                                "correlationId": "4c04bdc2-7130-46ed-8533-0c650b3c17a5",
                                "order":{
                                    "results": [
                                        {
                                            "designationId": "SBO/IP/04567",
                                            "status": "SUCCESS",
                                            "billingRequestCompletionDate": "2025-11-24",
                                            "networkRequestCompletionDate": "2025-11-25"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "Erro": {
                        "summary": "Exemplo Callback Erro",
                        "value": {
                            "data": {
                                "correlationId": "4c04bdc2-7130-46ed-8533-0c650b3c17a5",
                                "order":{
                                    "results": [
                                        {
                                            "designationId": "SBO/IP/04567",
                                            "status": "ERROR",
                                            "billingRequestCompletionDate": "2025-11-24",
                                            "networkRequestCompletionDate": "2025-11-25",
                                            "error": {
                                                "date": "2025-11-22",
                                                "code": "ERR-010",
                                                "message": "Unknown designation id"
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/SucessResponse"
          },
