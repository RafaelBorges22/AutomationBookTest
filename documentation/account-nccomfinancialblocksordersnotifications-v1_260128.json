    "schemas": {
      "FinancialBlocksNotificationsRequest": {
        "type": "object",
        "description": "Estrutura enviada para solicitando ação de bloqueio/desbloqueio.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "correlationId",
              "results"
            ],
            "properties": {
              "correlationId": {
                "type": "string",
                "description": "ID da transação",
                "example": "4c04bdc2-7130-46ed-8533-0c650b3c17a5"
              },
              "order": {
                "properties": {
                  "results": {
                    "type": "array",
                    "description": "Array de resultados, contendo uma entrada para cada designação processada. ",
                    "items": {
                      "type": "object",
                      "properties": {
                        "designationId": {
                          "type": "string",
                          "description": "Designação do serviço bloqueado / desbloqueado",
                          "example": "SBO/IP/02163"
                        },
                        "status": {
                          "type": "string",
                          "description": "Status do processamento. Valores possíveis: 'SUCCESS' ou 'ERROR'",
                          "example": "SUCCESS"
                        },
                        "billingRequestCompletionDate": {
                          "type": "string",
                          "description": "Data em que o bloqueio/desbloqueio de cobrança foi processada no FDS",
                          "example": "2025-11-24"
                        },
                        "networkRequestCompletionDate": {
                          "type": "string",
                          "description": "Data em que a rede bloqueou/desbloqueou o serviço",
                          "example": "2025-11-25"
                        },
                        "error": {
                          "properties": {
                            "date": {
                              "type": "string",
                              "description": "Data do erro de processo, caso status == 'ERROR'",
                              "example": "2025-11-22"
                            },
                            "code": {
                              "type": "string",
                              "description": "Código do erro, caso status == 'ERROR'",
                              "example": "ERR-010"
                            },
                            "message": {
                              "type": "string",
                              "description": "Mensagem do erro, caso status == 'ERROR' ",
                              "example": "Unknown designation id"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "FinancialBlocksNotificationsResponse": {
        "type": "object",
        "description": "Registro salvo na tabela de relatório.",
        "required": [
          "apiVersion",
          "transactionId",
          "data"
        ],
        "properties": {
          "apiVersion": {
            "type": "string",
            "description": "Retorna sempre a versão major e minor da API efetivamente consumida. O formato é “versão major;versão minor”. Exemplo: “apiVersion”: “2;2026-01-20”. Quando a versão minor não é solicitada, a versão contratada pelo cliente é retornada. Quando não há restrição de contratação, retorna a última disponível.",
            "example": "1;2026-01-20"
          },
          "transactionId": {
            "type": "string",
            "example": "b6195102-ea4f-44e8-fed5-386e4ec2a373",
            "description": "Retorna o identificador de rastreabilidade de transação gerado pela API."
          }
        }
      },
      "errorNotificationsResponse": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string",
            "description": "Retorna sempre a versão major e minor da API efetivamente consumida. O formato é “versão major;versão minor”. Exemplo: “apiVersion”: “1;2026-01-20”. Quando a versão minor não é solicitada, a versão contratada pelo cliente é retornada. Quando não há restrição de contratação, retorna a última disponível.",
            "example": "1;2026-01-20"
          },
          "transactionId": {
            "type": "string",
            "format": "uuid",
            "description": "Retorna o identificador de rastreabilidade de transação gerado pela API.",
            "example": "b6195102-ea4f-44e8-fed5-386e4ec2a373"
          },
          "error": {
            "type": "object",
            "description": "Detalhes do erro ocorrido.",
            "properties": {
              "httpCode": {
                "type": "string",
                "description": "Código HTTP em formato string.",
                "example": "400"
              },
              "errorCode": {
                "type": "string",
                "description": "Código interno da API para o erro.",
                "example": "API-NCCOMFINANCIALBLOCKSORDERSNOTIFICATIONS-400"
              },
              "message": {
                "type": "string",
                "description": "Mensagem resumida do erro.",
                "example": "Bad Request."
              },
              "detailedMessage": {
                "type": "string",
                "description": "Mensagem detalhada do erro.",
                "example": "Bad Request."
              },
              "link": {
                "type": "object",
                "description": "Link relacionado ao erro.",
                "properties": {
                  "rel": {
                    "type": "string",
                    "description": "Relação do link com o recurso.",
                    "example": "related"
                  },
                  "href": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL para documentação ou recurso relacionado.",
                    "example": "https://api.com.br/docs"
                  }
                },
                "required": [
                  "rel",
                  "href"
                ]
              }
            },
            "required": [
              "httpCode",
              "errorCode",
              "message"
            ]
          }
        },
        "required": [
          "apiVersion",
          "transactionId",
          "error"
        ]
      }
    },
