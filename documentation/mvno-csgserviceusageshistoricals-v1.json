    "schemas": {
      "error": {
        "description": "Object returned when an error occurs (4xx/5xx)",
        "type": "object",
        "required": [
          "apiVersion",
          "transactionId",
          "error"
        ],
        "properties": {
          "apiVersion": {
            "type": "string",
            "description": "Major and minor API Version.",
            "example": "1;2019-09-11"
          },
          "transactionId": {
            "type": "string",
            "description": "Transaction´s tracking identification generated by API.",
            "example": "Id-2d0384f0823434"
          },
          "error": {
            "type": "object",
            "properties": {
              "httpCode": {
                "type": "string",
                "description": "HTTP error code"
              },
              "errorCode": {
                "type": "string",
                "description": "Internal API error code. Ex.: API-3566. This code can be used by consumer to map its error message."
              },
              "message": {
                "type": "string",
                "description": "Error Message."
              },
              "detailedMessage": {
                "type": "string",
                "description": "Detailed error message."
              },
              "link": {
                "type": "object",
                "description": "Object containing page link to errors detailed documentation on API Portal.",
                "properties": {
                  "rel": {
                    "type": "string",
                    "enum": [
                      "related"
                    ],
                    "description": "To reference the API portal error page is used the “related” semantics in this scenario."
                  },
                  "href": {
                    "type": "string",
                    "description": "Resource URL"
                  }
                }
              }
            }
          }
        },
        "xml": {
          "name": "xml"
        }
      },
      "SubscriberUsageMonthlyReportRequest": {
        "type": "object",
        "properties": {
          "numberOfCycles": {
            "type": "integer",
            "default": 6,
            "minimum": 1,
            "description": "Number of billing cycles (months) to include. If it not included. It will Defaults to 6."
          }
        }
      },
      "SubscriberUsageMonthlyReportResponse": {
        "required": [
          "apiVersion",
          "transactionId",
          "data"
        ],
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string",
            "description": "Retorna sempre a versão major e minor da API efetivamente consumida. O formato é “versão major;versão minor”. Exemplo: “apiVersion”: “2;2015-08-12”. Quando a versão minor não é solicitada, a versão contratada pelo cliente é retornada. Quando não há restrição de contratação, retorna a última disponível.",
            "example": "2;2020-06-11"
          },
          "transactionId": {
            "type": "string",
            "description": "Retorna o identificador de rastreabilidade de transação gerado pela API.",
            "example": "e6e4e0f4-089d-4194-845e-78f45426f7c7"
          },
          "data": {
            "type": "object",
            "properties": {
              "dateRange": { "$ref": "#/components/schemas/SubscriberUsageMonthlyDateRange" },
              "subscriber": { "$ref": "#/components/schemas/SubscriberUsageMonthlySubscriber" },
              "voiceUsageByCycle": {
                "type": "array",
                "description": "Monthly aggregated voice usage in minutes (MIN)",
                "items": { "$ref": "#/components/schemas/MonthlyUsageEntry" }
              },
              "smsUsageByCycle": {
                "type": "array",
                "description": "Monthly aggregated SMS usage count (COUNT)",
                "items": { "$ref": "#/components/schemas/MonthlyUsageEntry" }
              },
              "dataUsageByCycle": {
                "type": "array",
                "description": "Monthly aggregated data usage in megabytes (MB)",
                "items": { "$ref": "#/components/schemas/MonthlyUsageEntry" }
              }
            }
          }
        }
      },
      "SubscriberUsageMonthlyReportFaultResponse": {
        "type": "object",
        "description": "Returned with **HTTP 200** when `RetrieveSubscriberUsageMonthlyReport` catches `FaultException` and returns `Ok(CreateFaultResponse(faultEx.Fault))`. Also returned with **HTTP 404** for `NotFoundException`. Shape from `SubscriberController.CreateFaultResponse`.",
        "properties": {
          "contextId": { "type": "string", "format": "uuid" },
          "fault": {
            "type": "object",
            "properties": {
              "code": { "type": "integer" },
              "message": { "type": "string" },
              "severity": { "type": "integer" }
            }
          }
        }
      },
      "SubscriberUsageMonthlyDateRange": {
        "type": "object",
        "description": "Date range covered by the monthly report",
        "properties": {
          "from": { "type": "string", "description": "Start date (yyyy-MM-dd)" },
          "to": { "type": "string", "description": "End date (yyyy-MM-dd)" }
        }
      },
      "SubscriberUsageMonthlySubscriber": {
        "type": "object",
        "description": "Subscriber information in the monthly usage report",
        "properties": {
          "address": { "$ref": "#/components/schemas/SubscriberUsageMonthlyAddress" },
          "email": { "type": "string" },
          "name": { "$ref": "#/components/schemas/SubscriberUsageMonthlySubscriberName" },
          "serviceIdentifier": { "type": "string", "description": "MSISDN or service identifier" },
          "serviceIdentifierType": { "type": "string", "description": "Type of identifier (e.g. MSISDN)" },
          "subscriberId": { "type": "string", "description": "Ascendon subscriber ID" }
        }
      },
      "SubscriberUsageMonthlyAddress": {
        "type": "object",
        "description": "Subscriber address details",
        "properties": {
          "city": { "type": "string" },
          "country": { "type": "string" },
          "line1": { "type": "string" },
          "line2": { "type": "string" },
          "postalCode": { "type": "string" },
          "state": { "type": "string" }
        }
      },
      "SubscriberUsageMonthlySubscriberName": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" }
        }
      },
      "MonthlyUsageEntry": {
        "type": "object",
        "description": "One billing cycle's aggregated usage value",
        "properties": {
          "month": {
            "type": "string",
            "description": "Billing cycle month range (e.g. 'JAN 2026-FEB 2026')",
            "example": "JAN 2026-FEB 2026"
          },
          "value": {
            "type": "number",
            "description": "Aggregated usage value for the cycle"
          },
          "unit": {
            "type": "string",
            "description": "Unit of measurement: MIN (voice minutes), COUNT (SMS count), MB (data megabytes)",
            "enum": [ "MIN", "COUNT", "MB" ]
          }
        }
      },
      "SubscriberUsageDetailsReportRequest": {
        "type": "object",
        "properties": {
          "usageByCycle": {
            "type": "boolean",
            "nullable": true,
            "description": "True or omitted: grouped cycles + activation window. False: flat lists + period (or default months)."
          },
          "numberOfCycles": {
            "type": "integer",
            "format": "int32",
            "default": 6,
            "description": "Billing cycle count when usageByCycle is enabled. **0** or omitted request → treated as **6**."
          },
          "period": {
            "$ref": "#/components/schemas/SubscriberUsageDetailsReportPeriod"
          },
          "pagination": {
            "$ref": "#/components/schemas/SubscriberUsageDetailsReportPagination"
          }
        }
      },
      "SubscriberUsageDetailsReportPeriod": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Start date (e.g. yyyy-MM-dd)",
            "example": "2025-09-01"
          },
          "to": {
            "type": "string",
            "description": "End date (e.g. yyyy-MM-dd)",
            "example": "2025-11-01"
          }
        }
      },
      "SubscriberUsageDetailsReportPagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "format": "int32", "default": 1 },
          "pageSize": { "type": "integer", "format": "int32", "default": 1000 }
        }
      },
      "SubscriberUsageDetailsReportResponse": {
        "required": [
          "apiVersion",
          "transactionId",
          "data"
        ],
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string",
            "description": "Retorna sempre a versão major e minor da API efetivamente consumida. O formato é “versão major;versão minor”. Exemplo: “apiVersion”: “2;2015-08-12”. Quando a versão minor não é solicitada, a versão contratada pelo cliente é retornada. Quando não há restrição de contratação, retorna a última disponível.",
            "example": "2;2020-06-11"
          },
          "transactionId": {
            "type": "string",
            "description": "Retorna o identificador de rastreabilidade de transação gerado pela API.",
            "example": "e6e4e0f4-089d-4194-845e-78f45426f7c7"
          },
          "data": {
            "type": "object",
            "properties": {
              "dateRange": { "$ref": "#/components/schemas/SubscriberUsageDetailsDateRange" },
              "pagination": { "$ref": "#/components/schemas/SubscriberUsageDetailsResponsePagination" },
              "subscriber": { "$ref": "#/components/schemas/SubscriberUsageDetailsSubscriber" },
              "usageByCycle": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/UsageDetailsByCycle" },
                "nullable": true
              },
              "dataUsageRecords": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/DataUsageRecord" }
              },
              "voiceUsageRecords": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/VoiceUsageRecord" }
              },
              "smsUsageRecords": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/SmsUsageRecord" }
              }
            }
          }
        }
      },
      "SubscriberUsageDetailsDateRange": {
        "type": "object",
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      },
      "SubscriberUsageDetailsResponsePagination": {
        "type": "object",
        "properties": {
          "hasMore": { "type": "boolean" },
          "page": { "type": "integer", "format": "int32" },
          "pageSize": { "type": "integer", "format": "int32" }
        }
      },
      "SubscriberUsageDetailsSubscriber": {
        "type": "object",
        "properties": {
          "address": { "$ref": "#/components/schemas/SubscriberUsageDetailsAddress" },
          "email": { "type": "string", "nullable": true },
          "name": { "$ref": "#/components/schemas/SubscriberUsageDetailsSubscriberName" },
          "serviceIdentifier": { "type": "string", "nullable": true },
          "serviceIdentifierType": { "type": "string", "nullable": true },
          "subscriberId": { "type": "string", "nullable": true }
        }
      },
      "SubscriberUsageDetailsAddress": {
        "type": "object",
        "properties": {
          "city": { "type": "string", "nullable": true },
          "country": { "type": "string", "nullable": true },
          "line1": { "type": "string", "nullable": true },
          "line2": { "type": "string", "nullable": true },
          "postalCode": { "type": "string", "nullable": true },
          "state": { "type": "string", "nullable": true }
        }
      },
      "SubscriberUsageDetailsSubscriberName": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string", "nullable": true },
          "lastName": { "type": "string", "nullable": true }
        }
      },
      "SubscriberUsageDetailsCycleDateRange": {
        "type": "object",
        "properties": {
          "from": { "type": "string", "nullable": true },
          "to": { "type": "string", "nullable": true }
        }
      },
      "UsageDetailsByCycle": {
        "type": "object",
        "properties": {
          "cycleDateRange": { "$ref": "#/components/schemas/SubscriberUsageDetailsCycleDateRange" },
          "dataUsageRecords": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DataUsageRecord" }
          },
          "voiceUsageRecords": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/VoiceUsageRecord" }
          },
          "smsUsageRecords": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SmsUsageRecord" }
          }
        }
      },
      "DataUsageRecord": {
        "type": "object",
        "properties": {
          "description": { "type": "string", "nullable": true },
          "eventTimestamp": { "type": "string", "nullable": true },
          "quantity": { "type": "number", "description": "Display quantity (e.g. normalized KB/MB/GB for data)." },
          "actualUsageAmount": { "type": "number", "description": "Parsed biller ActualUsageAmount; for data in bytes, scaled to same unit as quantity when applicable." },
          "unit": { "type": "string", "nullable": true },
          "roaming": { "type": "boolean" },
          "usageDate": { "type": "string", "nullable": true },
          "usageTime": { "type": "string", "nullable": true }
        }
      },
      "VoiceUsageRecord": {
        "type": "object",
        "properties": {
          "description": { "type": "string", "nullable": true },
          "direction": { "type": "string", "nullable": true },
          "eventTimestamp": { "type": "string", "nullable": true },
          "from": { "type": "string", "nullable": true },
          "quantity": { "type": "number" },
          "actualUsageAmount": { "type": "number" },
          "unit": { "type": "string", "nullable": true },
          "roaming": { "type": "boolean" },
          "to": { "type": "string", "nullable": true },
          "usageDate": { "type": "string", "nullable": true },
          "usageTime": { "type": "string", "nullable": true }
        }
      },
      "SmsUsageRecord": {
        "type": "object",
        "properties": {
          "description": { "type": "string", "nullable": true },
          "direction": { "type": "string", "nullable": true },
          "eventTimestamp": { "type": "string", "nullable": true },
          "from": { "type": "string", "nullable": true },
          "quantity": { "type": "number" },
          "actualUsageAmount": { "type": "number" },
          "unit": { "type": "string", "nullable": true },
          "roaming": { "type": "boolean" },
          "to": { "type": "string", "nullable": true },
          "usageDate": { "type": "string", "nullable": true },
          "usageTime": { "type": "string", "nullable": true }
        }
      },
      "errorDetails": {
        "type": "object",
        "description": "Objeto retornado quando ocorre erro no response de alguma das API's orquestradas pela CSG.",
        "properties": {
          "Code": {
            "type": "string",
            "description": "Recebe ou define o codigo de erro.",
            "nullable": true
          },
          "Message": {
            "type": "string",
            "description": "Recebe ou define a mensagem de erro.",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "ClientAuthHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Client-Auth"
      },
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Client-Key"
      },
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth2/v1/token",
            "scopes": {}
          }
        }
      }
    }
  }
}