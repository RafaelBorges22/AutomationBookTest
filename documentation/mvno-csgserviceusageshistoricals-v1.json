  "paths": {
    "/csg/serviceusages/historicals": {
      "post": {
        "tags": [
          "Subscriber Usages"
        ],
        "summary": "API responsável por retornar o histórico de consumo de Dados, Voz e SMS de um assinante MVNO detalhados por período ou ciclo. 'Backend: CSG Ascendon'",
        "x-claro-backends": [
          "CSG Ascendon"
        ],
        "x-claro-domains": [
          "Usage Consumption"
        ],
        "description": "API responsável por retornar o histórico de consumo de Dados, Voz e SMS de um assinante MVNO detalhados por período ou ciclo.",
        "parameters": [
          {
            "name": "CD-ServiceIdentifier",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "5511999999999"
            },
            "description": "Número do MSISDN."
          },
          {
            "name": "CD-SubscriberId",
            "in": "header",
            "required": false,
            "description": "Código de identificação do assinante na plataforma do Ascendon.",
