    "paths": {
        "/nc/cip/customers/contracts": {
            "get": {
                "summary": "Consultar dados de contratos do cliente, provenientes do IBS, do COM e do CPQ.  Backend: NC CIP - Cloud Integration Platform",
                "operationId": "getCustomerContracts",
                "tags": [
                    "Customer Contracts"
                ],
                "parameters": [
                    {
                        "name": "designationId",
                        "in": "query",
                        "required": true,
                        "description": "Designação do serviço recebida na request",
                        "schema": {
                            "type": "string",
                            "example": "SBO/IP/02163"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Consulta realizada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Contract"
                                },
                                "example": {
                                    "apiVersion": "1;2026-02-19",
                                    "transactionId": "b6195102-ea4f-44e8-fed5-386e4ec2a373",
                                    "data": {
