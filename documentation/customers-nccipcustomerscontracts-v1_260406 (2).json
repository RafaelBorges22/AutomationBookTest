        "schemas": {
            "Contract": {
                "type": "object",
                "required": [
                    "apiVersion",
                    "transactionId",
                    "data"
                ],
                "properties": {
                    "apiVersion": {
                        "type": "string",
                        "description": "Retorna sempre a versão major e minor da API efetivamente consumida. O formato é “versão major;versão minor”. Exemplo: “apiVersion”: “2;2021-06-19”. Quando a versão minor não é solicitada, a versão contratada pelo cliente é retornada. Quando não há restrição de contratação, retorna a última disponível.",
                        "example": "1;2026-02-19"
                    },
                    "transactionId": {
                        "type": "string",
                        "example": "b6195102-ea4f-44e8-fed5-386e4ec2a373",
                        "description": "Retorna o identificador de rastreabilidade de transação gerado pela API."
                    },
                    "data": {
                        "type": "object",
                        "properties": {
                            "contract": {
                                "type": "object",
                                "description": "Dados contratuais unificados (IBS/COM)",
                                "properties": {
                                    "designationId": {
                                        "type": "string",
                                        "description": "Designação do serviço",
                                        "example": "SBO/IP/02163"
                                    },
                                    "activationDate": {
                                        "type": "string",
                                        "description": "Data de ativação do contrato DD/MM/YYYY",
                                        "example": "19/02/2026"
                                    },
                                    "cleAccountId": {
                                        "type": "string",
                                        "description": "CLE account",
                                        "example": "12345678901-0001"
                                    },
                                    "grcActive": {
                                        "type": "string",
                                        "description": "Indica se o GRC está ativo em qualquer uma das portas WAN.",
                                        "example": "Sim"
                                    },
                                    "product": {
                                        "type": "object",
                                        "description": "Informações do produto SIR",
                                        "properties": {
                                            "sirProductCode": {
                                                "type": "string",
                                                "description": "Código do produto específico do SIR",
                                                "example": "0280"
                                            },
                                            "vendor": {
                                                "type": "string",
                                                "description": "Vendor",
                                                "example": "Vendor"
                                            },
                                            "fgNationalInternationalInstance": {
                                                "type": "string",
                                                "description": "N – indica que todas as instâncias são nacionais",
                                                "example": "N"
                                            }
                                        }
                                    },
                                    "technicalContact": {
                                        "type": "object",
                                        "description": "Contato técnico do cliente",
                                        "properties": {
                                            "phoneNumber": {
                                                "type": "string",
                                                "description": "Telefone do contato técnico do cliente",
                                                "example": "11987654321"
                                            }
                                        }
                                    },
                                    "installationAddress": {
                                        "type": "object",
                                        "description": "Endereço da instalação do contrato",
                                        "properties": {
                                            "streetType": {
                                                "type": "string",
                                                "description": "Tipo do logradouro (ex.: Rua, Avenida, Alameda, Travessa).",
                                                "example": "Rua"
                                            },
                                            "streetName": {
                                                "type": "string",
                                                "description": "Nome do logradouro, sem o tipo.",
                                                "example": "das Flores"
                                            },
                                            "number": {
                                                "type": "string",
                                                "description": "Número do imóvel no logradouro.",
                                                "example": "123"
                                            },
                                            "additionalInformation": {
                                                "type": "string",
                                                "description": "Complemento do endereço, como bloco, apartamento, sala ou referência adicional.",
                                                "example": "Apto 45, Bloco B"
                                            },
                                            "district": {
                                                "type": "string",
                                                "description": "Bairro onde o imóvel está localizado.",
                                                "example": "Centro"
                                            },
                                            "zipCode": {
                                                "type": "string",
                                                "description": "Código de Endereçamento Postal (CEP).",
                                                "example": "13200-000"
                                            },
                                            "city": {
                                                "type": "string",
                                                "description": "Nome do município.",
                                                "example": "Jundiaí"
                                            },
                                            "state": {
                                                "type": "string",
                                                "description": "Nome completo do estado.",
                                                "example": "São Paulo"
                                            },
                                            "acronym": {
                                                "type": "string",
                                                "description": "Sigla da unidade federativa (UF).",
                                                "example": "SP"
                                            },
                                            "addressTypeIndicator": {
                                                "type": "string",
                                                "description": "Fixo “2” – tipo da instalação no site do cliente",
                                                "example": "2"
                                            },
                                            "locationCode": {
                                                "type": "string",
                                                "description": "Código CNL (Código Nacional de Logradouro) utilizado para identificação padronizada do endereço.",
                                                "example": "3550308123456"
                                            }
                                        }
                                    },
                                    "cpes": {
                                        "type": "array",
                                        "description": "Lista de CPEs do contrato, cada um com a sua lista de WANS.",
                                        "items": {
                                            "$ref": "#/components/schemas/Cpe"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "Cpe": {
                "type": "object",
                "description": "CPE com sua lista de WANS.",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Identificador do CPE.",
                        "example": "1"
                    },
                    "wans": {
                        "type": "array",
                        "description": "Lista de conectividades WAN associadas ao CPE.",
                        "items": {
                            "$ref": "#/components/schemas/Wan"
                        }
                    }
                },
                "required": [
                    "id",
                    "wans"
                ]
            },
            "Wan": {
                "type": "object",
                "description": "Estrutura padrão de conectividade WAN por CPE",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Identificador da WAN.",
                        "example": "1"
                    },
                    "connectivityDesignation": {
                        "type": "string",
                        "description": "Designação da conectividade WAN.",
                        "example": "WAN1-CPE"
                    }
                },
                "required": [
                    "id",
                    "connectivityDesignation"
                ]
            },
            "ErrorResponse": {
                "type": "object",
                "required": [
                    "apiVersion",
                    "transactionId",
                    "error"
                ],
                "properties": {
                    "apiVersion": {
                        "type": "string",
                        "example": "1;2026-02-27"
                    },
                    "transactionId": {
                        "type": "string",
                        "example": "b6195102-ea4f-44e8-fed5-386e4ec2a373"
                    },
                    "error": {
                        "type": "object",
                        "description": "Detalhes do erro ocorrido",
                        "properties": {
                            "httpCode": {
                                "type": "string",
                                "description": "Código HTTP em formato string",
                                "example": "400"
                            },
                            "errorCode": {
                                "type": "string",
                                "description": "Código interno da API para o erro",
                                "example": "API-NCCIPCUSTOMERSCONTRACTS-400"
                            },
                            "message": {
                                "type": "string",
                                "description": "Mensagem resumida do erro",
                                "example": "Bad Request."
                            },
                            "detailedMessage": {
                                "type": "string",
                                "description": "Mensagem detalhada do erro",
                                "example": "Bad Request."
                            },
                            "link": {
                                "type": "object",
                                "description": "Link relacionado ao erro",
                                "properties": {
                                    "rel": {
                                        "type": "string",
                                        "description": "Relação do link com o recurso",
                                        "example": "related"
                                    },
                                    "href": {
                                        "type": "string",
                                        "format": "uri",
                                        "description": "URL para documentação ou recurso relacionado",
                                        "example": "https://api.claro.com.br/docs"
                                    }
                                },
                                "required": [
                                    "rel",
                                    "href"
                                ]
                            }
                        },
                        "required": [
                            "httpCode",
                            "errorCode",
                            "message"
                        ]
                    }
                }
            }
        },
