                                            "designationId": "SBO/IP/02163",
                                            "activationDate": "19/02/2026",
                                            "cleAccountId": "12345678901-0001",
                                            "grcActive": "Sim",
                                            "product": {
                                                "sirProductCode": "0280",
                                                "vendor": "Vendor",
                                                "fgNationalInternationalInstance": "N"
                                            },
                                            "technicalContact": {
                                                "phoneNumber": "11987654321"
                                            },
                                            "installationAddress": {
                                                "streetType": "Rua",
                                                "streetName": "das Flores",
                                                "number": "123",
                                                "additionalInformation": "Apto 45, Bloco B",
                                                "district": "Centro",
                                                "zipCode": "13200-000",
                                                "city": "Jundiaí",
                                                "state": "São Paulo",
                                                "acronym": "SP",
                                                "addressTypeIndicator": "2",
                                                "locationCode": "3550308123456"
                                            },
                                            "cpes": [
                                                {
                                                    "id": "1",
                                                    "wans": [
                                                        {
                                                            "id": "1",
                                                            "connectivityDesignation": "WAN1-CPE"
                                                        },
                                                        {
                                                            "id": "2",
                                                            "connectivityDesignation": "WAN2-CPE"
                                                        },
                                                        {
                                                            "id": "3",
                                                            "connectivityDesignation": "WAN3-CPE"
                                                        },
                                                        {
                                                            "id": "4",
                                                            "connectivityDesignation": "WAN4-CPE"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "2",
                                                    "wans": [
                                                        {
                                                            "id": "1",
                                                            "connectivityDesignation": "WAN1-CPE"
                                                        },
